{
  "name": "timesheet-program",
  "private": true,
  "version": "0.1.0",
  "description": "Jibble missed-timeclock reporting & correction webapp",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace apps/api & npm run dev --workspace apps/web",
    "dev:api": "npm run dev --workspace apps/api",
    "dev:web": "npm run dev --workspace apps/web",
    "build": "npm run build --workspaces --if-present && npm run db:generate --workspace apps/api",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "db:push": "npm run db:push --workspace apps/api",
    "db:seed": "npm run db:seed --workspace apps/api",
    "start": "node apps/api/dist/index.js"
  },
  "engines": {
    "node": ">=20"
  }
}
