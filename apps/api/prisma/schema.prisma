// Prisma schema — SQLite for local/dev speed.
// To move to Postgres later: change `provider` to "postgresql" and point
// DATABASE_URL at the Postgres instance. Model definitions stay the same.

generator client {
  provider = "prisma-client-js"
  // Cover local dev (native), Render (debian), and AWS App Runner (rhel/AL) so
  // the query engine binary is present wherever the app runs.
  binaryTargets = ["native", "debian-openssl-3.0.x", "rhel-openssl-1.0.x", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// A single missed-timeclock / adjustment request submitted by an employee.
model CorrectionRequest {
  id                   String   @id @default(cuid())
  employeeName         String
  jibblePersonId       String?
  /// Jibble entry being changed, when this request edits an existing entry.
  jibbleEntryId        String?
  employeeEmail        String
  date                 String // ISO date YYYY-MM-DD
  eventType            String // "in" | "out" | "adjust"
  intendedTime         String // HH:mm (24h, local)
  reason               String
  status               String   @default("pending") // see RequestStatus in @timesheet/shared

  // Employee attestation captured at submission time.
  submitterSignature   String?
  affirmed             Boolean  @default(false)

  decisionNote         String?
  decidedByAdminId     String?
  decidedByAdmin       Admin?   @relation(fields: [decidedByAdminId], references: [id])
  decidedAt            DateTime?

  // Result of the Jibble write attempt (raw response id / error), for audit.
  jibbleResult         String?

  // Immutable JSON snapshot of the change, generated when an admin decides.
  digitalRecord        String?

  // Digital record acknowledgement: employee signs off on the change.
  employeeAckSignature String?
  ackAt                DateTime?

  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  @@index([employeeEmail])
  @@index([status])
}

/// A timeclock admin who reviews the queue. Identity is federated to Jibble
/// (Phase 4); this row caches the profile so we can attribute decisions.
model Admin {
  id            String   @id @default(cuid())
  jibbleUserId  String?  @unique
  email         String   @unique
  name          String
  createdAt     DateTime @default(now())

  decisions     CorrectionRequest[]
}

/// An employee's app-native login, mapped to their Jibble person by email.
/// Lets us auto-fill their identity and load their Jibble timesheet on sign-in
/// without any Jibble OAuth setup.
model Employee {
  id                 String   @id @default(cuid())
  email              String   @unique
  fullName           String
  passwordHash       String
  jibblePersonId     String?
  /// True until the employee changes the admin-set default password (kiosk PIN).
  mustChangePassword Boolean  @default(false)
  createdAt          DateTime @default(now())
}

/// Short-lived token for the employee status-lookup magic link (Phase 3).
model MagicLinkToken {
  id         String   @id @default(cuid())
  email      String
  token      String   @unique
  expiresAt  DateTime
  usedAt     DateTime?
  createdAt  DateTime @default(now())

  @@index([email])
}
