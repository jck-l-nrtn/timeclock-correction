# --- API ---
PORT=4000
NODE_ENV=development
WEB_ORIGIN=http://localhost:5173

# --- Database (SQLite for dev) ---
DATABASE_URL="file:./dev.db"

# --- Jibble API (Phase 5 — leave blank to use the stub client) ---
JIBBLE_IDENTITY_URL=https://identity.prod.jibble.io
JIBBLE_WORKSPACE_URL=https://workspace.prod.jibble.io
JIBBLE_TIME_TRACKING_URL=https://time-tracking.prod.jibble.io
JIBBLE_CLIENT_ID=
JIBBLE_CLIENT_SECRET=
JIBBLE_ORG_TIMEZONE=America/Denver

# --- Notifications (optional) ---
# If set, new-request and decision events POST to this webhook (Slack/Teams/Discord
# incoming webhook, or any JSON endpoint). Left blank -> console logging only.
# Magic links are NEVER sent to the webhook (they contain a login token).
NOTIFY_WEBHOOK_URL=

# --- Email (SMTP — Resend, SES, Mailgun, etc.) ---
# Leave blank to disable email (calls become console logs).
# For Resend: SMTP_HOST=smtp.resend.com  SMTP_USER=resend  SMTP_PASS=<re_ API key>
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=
# Where new-request alerts and the weekly report are sent:
NOTIFY_EMAIL_TO=

# --- Alternative: Gmail via OAuth2 (instead of SMTP above) ---
GMAIL_USER=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=

# --- Weekly pay-period report ---
# Secret the scheduler passes to POST /api/reports/pay-period/send
REPORT_TOKEN=
ORG_NAME=Montane Packaging

# --- Admin auth (Phase 4) ---
DEV_LOGIN_ENABLED=true
SESSION_SECRET=change-me-in-production
