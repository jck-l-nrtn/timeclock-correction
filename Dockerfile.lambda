# AWS Lambda container image. Built in a full Node image, then copied into the
# Lambda base so pdfkit's font assets and all node_modules ship intact (no
# bundling gymnastics).

FROM node:22-bookworm-slim AS build
WORKDIR /build
COPY package.json package-lock.json ./
COPY packages/shared/package.json ./packages/shared/
COPY apps/api/package.json ./apps/api/
COPY apps/web/package.json ./apps/web/
RUN npm install --include=dev
COPY . .
RUN npm run build --workspace @timesheet/shared \
 && npm run build --workspace @timesheet/api \
 && rm -rf apps/web \
 && npm prune --omit=dev

FROM public.ecr.aws/lambda/nodejs:20
# Preserve the monorepo layout so workspace symlinks (@timesheet/shared) resolve.
COPY --from=build /build ${LAMBDA_TASK_ROOT}
# handler = <file path without .js>.<exported function>
CMD ["apps/api/dist/lambda.handler"]
